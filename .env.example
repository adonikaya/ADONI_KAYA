# ADONI KAYA (અડોણી કાયા) — Environment Configuration Template

# Google Sheets Analytics Integration
# -------------------------------------------------------------
# Google Sheet ID:
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheets_spreadsheet_id

# Google Apps Script Web App Deployment URL
# (Obtain this by deploying google-apps-script/Code.gs as a Web App in your Google Sheet)
GOOGLE_APPS_SCRIPT_URL=
NEXT_PUBLIC_GOOGLE_APPS_SCRIPT_URL=

# GitHub / Deployment Subpath (Set automatically by GitHub Actions or leave empty for custom domain/Vercel)
# NEXT_PUBLIC_BASE_PATH=
